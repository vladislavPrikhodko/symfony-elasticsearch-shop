{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
<h1>Products</h1>

<ul>
    {% for product in products %}
        <li>
            <a href="{{ path('product_show', { slug: product.slug }) }}">
                {{ product.name }}
            </a>
            — {{ (product.price / 100)|number_format(2, '.', ' ') }} €
        </li>
    {% else %}
        <li>No products found</li>
    {% endfor %}
</ul>
{% endblock %}

{% extends 'base.html.twig' %}

{% block body %}

<h1>Каталог товаров</h1>

<h3>Категории</h3>

<ul>
    <li>
        <a href="{{ path('homepage') }}">
            Все
        </a>
    </li>

    {% for category in categories %}
        <li>
            <a href="{{ path('category_show', {
                slug: category.slug
            }) }}">
                {{ category.name }}
            </a>
        </li>
    {% endfor %}
</ul>

<hr>

{% for product in products %}
    <div style="margin-bottom:20px;">
        <h3>
            <a href="{{ path('product_show', {
                slug: product.slug
            }) }}">
                {{ product.name }}
            </a>
        </h3>

        <p>
            {{ product.price }} грн
        </p>

        {% if product.image %}
            <img src="/uploads/products/{{ product.image }}"
                 width="150">
        {% endif %}
    </div>
{% else %}
    <p>Нет товаров</p>
{% endfor %}

{% endblock %}